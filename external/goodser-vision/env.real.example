# 真实视觉服务环境变量示例
# 使用：cp .env.real.example .env.real，然后按需修改
DEVICE=cuda
GOODSER_VISION_EMBEDDER=clip
GOODSER_VISION_DETECTOR=yolo
GOODSER_VISION_EMBED_DIM=512
GOODSER_VISION_MAX_CONCURRENCY=1
GOODSER_VISION_MAX_IMAGE_SIDE=1920
GOODSER_VISION_MODEL_DIR=/app/models
GOODSER_VISION_WARMUP=1
GOODSER_VISION_IDLE_UNLOAD_SECONDS=0
GOODSER_VISION_IDLE_CHECK_SECONDS=30
GOODSER_VISION_GPU_MEMORY_FRACTION=0.5
GOODSER_VISION_GPU_HEADROOM_MB=1024
GOODSER_VISION_VLM_ENABLED=0
GOODSER_VISION_VLM_PROVIDER=disabled
GOODSER_VISION_VLM_BASE_URL=
GOODSER_VISION_VLM_API_KEY=
GOODSER_VISION_VLM_MODEL=qwen2.5-vl-3b-instruct
GOODSER_VISION_VLM_CONFIG_FILE=data/vlm.json
HF_HOME=/app/hf-cache
PADDLEOCR_HOME=/app/paddle-cache
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
