# ============================================
# Go-Backend-Core 环境变量模板
# 复制为 .env 后按实际环境填写；.env 已被 .gitignore 忽略
# 优先级：Docker Secret > .env > config.yaml > 默认值
# 命名规则：APP_ + 配置路径（大写 + 下划线）
#
# 单文件多环境：
#   只维护一份 .env，用 APP_PROFILE=dev|host|backup|cloud 标记当前环境。
#   环境差异用 APP_<PROFILE>_* 前缀覆盖，例如 APP_HOST_SERVER_PUBLIC_BASE_URL。
#   数据库：开发 GoBackendCoreDev；生产/灾备 GoBackendCoreDatabase（同账号，灾备不常启）。
# ============================================

# 当前环境：dev / host / backup / cloud
APP_PROFILE=dev

# --- 镜像与端口 ---
# GHCR 镜像标签：latest / v1.0.0
APP_IMAGE_TAG=latest
# Chrome 宿主机调试端口（不需要宿主机直连可删除 compose 中的 ports）
CHROME_HOST_PORT=3000

# --- 节点地址矩阵 ---
# L1 主机 / L2 备份 / ACloud 云服务器
# 网络规则：开发走 EasyTier；L1↔L2 走内网；L1/L2↔云走公网；对外服务用公网。
L1_PUBLIC=nas.hailong.site
L1_INTRANET=
L1_EASYTIER=10.144.144.10

L2_PUBLIC=
L2_INTRANET=
L2_EASYTIER=

ACLOUD_PUBLIC=eoth.hailong.site
ACLOUD_INTRANET=
ACLOUD_EASYTIER=

# 兼容旧变量（逐步废弃）
NAS_URL=${L1_PUBLIC}
CLOUD_URL=${ACLOUD_PUBLIC}
EASY_TIER_NAS_URL=${L1_EASYTIER}
EASY_TIER_CLOUD_URL=${ACLOUD_EASYTIER}

# --- 服务器 ---
APP_SERVER_NAME=go-backend-core
APP_SERVER_VERSION=release-v0.1.0
APP_SERVER_PORT=29090
APP_SERVER_MODE=release
# 对外访问地址（第三方登录回调/远程登录链接）；留空则仅使用相对路径
APP_SERVER_PUBLIC_BASE_URL=
# Swagger Try it out 默认后端地址
APP_SERVER_SWAGGER_BACKEND_ADDR=localhost:29090

# --- 日志 ---
APP_LOG_LEVEL=info
APP_LOG_FORMAT=json
APP_LOG_OUTPUT=stdout
APP_LOG_LOG_DIR=logs
APP_LOG_MAX_SIZE_MB=127
APP_LOG_MAX_AGE_DAYS=70

# --- 数据库通用 ---
# 生产必须 false；仅本地调试可开，Schema 由 migrations 管理
APP_DATABASE_AUTO_MIGRATE=false
# manual：维护时显式切 L2；auto：连接失败自动尝试 fallback（不推荐与手动维护混用）
APP_DATABASE_FAILOVER_MODE=manual

# --- PostgreSQL（V3 开发库）---
# 开发：GoBackendCoreDev；生产/灾备：GoBackendCoreDatabase。
APP_DATABASE_POSTGRES_MAIN_ENABLED=true
APP_DATABASE_POSTGRES_MAIN_HOST=${L1_EASYTIER}
APP_DATABASE_POSTGRES_MAIN_PORT=5432
APP_DATABASE_POSTGRES_MAIN_USER=GoBackendCoreDev
APP_DATABASE_POSTGRES_MAIN_PASSWORD=change-me
APP_DATABASE_POSTGRES_MAIN_DBNAME=GoBackendCoreDev
APP_DATABASE_POSTGRES_MAIN_SSLMODE=disable
APP_DATABASE_POSTGRES_MAIN_SEARCH_PATH=public
APP_DATABASE_POSTGRES_MAIN_TIMEZONE=UTC
APP_DATABASE_POSTGRES_MAIN_MAX_OPEN=30
APP_DATABASE_POSTGRES_MAIN_MAX_IDLE=10
APP_DATABASE_POSTGRES_MAIN_CONN_MAX_LIFETIME=30m
# L1 不可用时自动尝试 L2
APP_DATABASE_POSTGRES_MAIN_FALLBACK_HOST=${L2_EASYTIER}
APP_DATABASE_POSTGRES_MAIN_FALLBACK_PORT=5432

# --- 环境端点覆盖（APP_<PROFILE>_*）---
# APP_PROFILE=dev 时默认连 L1 EasyTier；host/backup 连内网；cloud 连 L1 公网。
APP_DEV_DATABASE_POSTGRES_MAIN_HOST=${L1_EASYTIER}
APP_DEV_DATABASE_POSTGRES_MAIN_FALLBACK_HOST=${L2_EASYTIER}
APP_DEV_DATABASE_POSTGRES_MAIN_DBNAME=GoBackendCoreDev
APP_DEV_DATABASE_POSTGRES_MAIN_USER=GoBackendCoreDev
APP_DEV_DATABASE_POSTGRES_MAIN_PASSWORD=GoBackendCoreDev

APP_HOST_DATABASE_POSTGRES_MAIN_HOST=${L1_INTRANET}
APP_HOST_DATABASE_POSTGRES_MAIN_FALLBACK_HOST=${L2_INTRANET}
APP_HOST_DATABASE_POSTGRES_MAIN_DBNAME=GoBackendCoreDatabase
APP_HOST_DATABASE_POSTGRES_MAIN_USER=GoBackendCoreDatabase
APP_HOST_DATABASE_POSTGRES_MAIN_PASSWORD=change-me

# L2 上启动 V3 时连 L2 本地库
APP_BACKUP_DATABASE_POSTGRES_MAIN_HOST=${L2_INTRANET}
APP_BACKUP_DATABASE_POSTGRES_MAIN_FALLBACK_HOST=${L1_INTRANET}
APP_BACKUP_DATABASE_POSTGRES_MAIN_DBNAME=GoBackendCoreDatabase
APP_BACKUP_DATABASE_POSTGRES_MAIN_USER=GoBackendCoreDatabase
APP_BACKUP_DATABASE_POSTGRES_MAIN_PASSWORD=change-me

APP_CLOUD_DATABASE_POSTGRES_MAIN_HOST=${L1_PUBLIC}
APP_CLOUD_DATABASE_POSTGRES_MAIN_FALLBACK_HOST=${L2_PUBLIC}
APP_CLOUD_DATABASE_POSTGRES_MAIN_DBNAME=GoBackendCoreDatabase
APP_CLOUD_DATABASE_POSTGRES_MAIN_USER=GoBackendCoreDatabase
APP_CLOUD_DATABASE_POSTGRES_MAIN_PASSWORD=change-me

APP_DEV_REDIS_MAIN_ADDR=${L1_EASYTIER}:6379
APP_DEV_REDIS_MAIN_FALLBACK_ADDR=${L2_EASYTIER}:6379
APP_HOST_REDIS_MAIN_ADDR=${L1_INTRANET}:6379
APP_HOST_REDIS_MAIN_FALLBACK_ADDR=${L2_INTRANET}:6379
APP_BACKUP_REDIS_MAIN_ADDR=${L2_INTRANET}:6379
APP_BACKUP_REDIS_MAIN_FALLBACK_ADDR=${L1_INTRANET}:6379
APP_CLOUD_REDIS_MAIN_ADDR=${L1_PUBLIC}:6379
APP_CLOUD_REDIS_MAIN_FALLBACK_ADDR=${L2_PUBLIC}:6379

APP_DEV_DATABASE_S3_RUSTFS_ENDPOINT=${ACLOUD_EASYTIER}:9000
APP_HOST_DATABASE_S3_RUSTFS_ENDPOINT=${ACLOUD_PUBLIC}:9000
APP_BACKUP_DATABASE_S3_RUSTFS_ENDPOINT=${ACLOUD_PUBLIC}:9000
APP_CLOUD_DATABASE_S3_RUSTFS_ENDPOINT=${ACLOUD_INTRANET}:9000

APP_DEV_SERVER_MODE=debug
APP_HOST_SERVER_MODE=release
APP_BACKUP_SERVER_MODE=release
APP_CLOUD_SERVER_MODE=release

APP_DEV_SERVER_PUBLIC_BASE_URL=http://localhost:29090
APP_HOST_SERVER_PUBLIC_BASE_URL=https://${L1_PUBLIC}
APP_BACKUP_SERVER_PUBLIC_BASE_URL=https://${L2_PUBLIC}
APP_CLOUD_SERVER_PUBLIC_BASE_URL=https://${ACLOUD_PUBLIC}

# --- MySQL（V2 兼容数据库；V3 运行时不使用）---
# HOST 使用 1panel-network 内的容器名，需与实际容器名完全一致
APP_DATABASE_MYSQL_MAIN_ENABLED=true
APP_DATABASE_MYSQL_MAIN_HOST=MySQL
APP_DATABASE_MYSQL_MAIN_PORT=3306
APP_DATABASE_MYSQL_MAIN_USER=GoBackendCoreDatabase
APP_DATABASE_MYSQL_MAIN_PASSWORD=change-me
APP_DATABASE_MYSQL_MAIN_DBNAME=GoBackendCoreDatabase
APP_DATABASE_MYSQL_MAIN_MAX_OPEN=50
APP_DATABASE_MYSQL_MAIN_MAX_IDLE=10
APP_DATABASE_MYSQL_MAIN_CONN_MAX_LIFETIME=30m

# --- PostgreSQL（NAS 辅助，默认关闭）---
# 未使用请保持 false，避免启动时连接失败
APP_DATABASE_POSTGRES_NAS_ENABLED=false
APP_DATABASE_POSTGRES_NAS_HOST=${NAS_URL}
APP_DATABASE_POSTGRES_NAS_PORT=8432
APP_DATABASE_POSTGRES_NAS_USER=GoBackendCoreDatabase
APP_DATABASE_POSTGRES_NAS_PASSWORD=change-me
APP_DATABASE_POSTGRES_NAS_DBNAME=GoBackendCoreDatabase
APP_DATABASE_POSTGRES_NAS_MAX_OPEN=20
APP_DATABASE_POSTGRES_NAS_MAX_IDLE=5
APP_DATABASE_POSTGRES_NAS_CONN_MAX_LIFETIME=30m

# --- RustFS 对象存储（默认关闭，商品图片上传用）---
APP_DATABASE_S3_RUSTFS_ENABLED=false
# RustFS 在 ACloud，不随 L1/L2 切换
APP_DATABASE_S3_RUSTFS_ENDPOINT=${ACLOUD_EASYTIER}:9000
APP_DATABASE_S3_RUSTFS_ACCESS_KEY=
APP_DATABASE_S3_RUSTFS_SECRET_KEY=
APP_DATABASE_S3_RUSTFS_USE_SSL=true
APP_DATABASE_S3_RUSTFS_BUCKET=
APP_DATABASE_S3_RUSTFS_REGION=us-east-1

# --- Redis ---
# 无密码留空；生产建议设置密码
APP_REDIS_MAIN_ENABLED=true
APP_REDIS_MAIN_ADDR=${L1_EASYTIER}:6379
APP_REDIS_MAIN_PASSWORD=
APP_REDIS_MAIN_DB=9
APP_REDIS_MAIN_POOL_SIZE=50

# --- 缓存 ---
APP_CACHE_DEFAULT_TTL=5m
APP_CACHE_DEFAULT_NIL_TTL=30s
APP_CACHE_JITTER=10s
APP_CACHE_L1_MAX_SIZE=10000
APP_CACHE_REDIS_KEY=main

# --- JWT（必须替换）---
# 生成示例：openssl rand -base64 48
APP_AUTH_JWT_SECRET=change-me-to-a-random-32+-character-secret
APP_AUTH_JWT_EXPIRE=24h

# --- 应用设置文件（可选）---
# 默认 data/settings.json；Compose 已挂载 ./data:/app/data
APP_SETTINGS_FILE=data/settings.json

# --- 集成连接器加密密钥（可选，32 字节 hex）---
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_CRYPTO_MASTER_KEY_HEX=

# --- OAuth2（按需填写，未使用保持空）---
APP_AUTH_OAUTH2_WECHAT_CLIENT_ID=
APP_AUTH_OAUTH2_WECHAT_CLIENT_SECRET=
APP_AUTH_OAUTH2_WECHAT_REDIRECT_URL=

APP_AUTH_OAUTH2_FEISHU_CLIENT_ID=
APP_AUTH_OAUTH2_FEISHU_CLIENT_SECRET=
APP_AUTH_OAUTH2_FEISHU_REDIRECT_URL=

APP_AUTH_OAUTH2_QQ_CLIENT_ID=
APP_AUTH_OAUTH2_QQ_CLIENT_SECRET=
APP_AUTH_OAUTH2_QQ_REDIRECT_URL=

APP_AUTH_OAUTH2_APPLE_CLIENT_ID=
APP_AUTH_OAUTH2_APPLE_TEAM_ID=
APP_AUTH_OAUTH2_APPLE_KEY_ID=
# 私钥不要直接写多行；建议 Docker Secret 或挂载文件
APP_AUTH_OAUTH2_APPLE_PRIVATE_KEY=
APP_AUTH_OAUTH2_APPLE_REDIRECT_URL=

APP_AUTH_OAUTH2_HUAWEI_CLIENT_ID=
APP_AUTH_OAUTH2_HUAWEI_CLIENT_SECRET=
APP_AUTH_OAUTH2_HUAWEI_REDIRECT_URL=

APP_AUTH_OAUTH2_HONOR_CLIENT_ID=
APP_AUTH_OAUTH2_HONOR_CLIENT_SECRET=
APP_AUTH_OAUTH2_HONOR_REDIRECT_URL=

# --- 调度器 ---
APP_SCHEDULER_ENABLED=true
APP_SCHEDULER_WORKER_CONCURRENCY=5
APP_SCHEDULER_DEFAULT_TIMEOUT=300
APP_SCHEDULER_DEFAULT_MAX_RETRIES=3
APP_SCHEDULER_LOG_RETENTION_DAYS=90

# --- 配置热加载（生产建议 false）---
APP_CONFIG_WATCH=false
APP_CONFIG_WATCH_INTERVAL=5s

# --- 采集浏览器 ---
# compose 默认使用 ws://chrome-browser:3000；非 compose 部署时填写实际地址
CHROME_REMOTE_URL=ws://chrome-browser:3000

# --- 外部工具（n8n / OpenClaw / LangBot）---
# 不需要在 .env 中配置地址或密码：
# 同一 1panel-network 内使用 http://gobackendcore:29090
# 鉴权使用 integration API Key（X-API-Key），在管理端创建并按作用域分配
